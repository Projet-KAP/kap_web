# Configuration Frontend KAP
# Copier ce fichier vers .env.development ou .env.production

# API Backend URL
VITE_API_BASE_URL=http://127.0.0.1:8002/api/v1/
VITE_API_TIMEOUT=120000

# Keycloak
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=sso-kap-alpha
VITE_KEYCLOAK_CLIENT_ID=kap

# Debug
VITE_DEBUG=true
VITE_LOG_LEVEL=debug
VITE_ENABLE_DEVTOOLS=true

# App Info
VITE_APP_NAME=KAP Console
VITE_APP_VERSION=1.0.0
